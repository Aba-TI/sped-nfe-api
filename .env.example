# API_KEY=troque-esta-chave
# API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

NFE_CERT_PATH=/var/www/sped-nfe/certs/certificado.pfx
NFE_CERT_PASSWORD=
NFE_TPAMB=2
NFE_RAZAO_SOCIAL=EMPRESA NAO INFORMADA
NFE_CNPJ=
NFE_SIGLA_UF=SP
NFE_SCHEMES=PL_009_V4
NFE_VERSAO=4.00
NFE_VERAPLIC=


curl -X POST "http://localhost:8080/api/nfce/31210524093799000176650010000173691736640278/consultar" \
  -H "Origin: http://localhost:3000" \
  -H "X-API-Key: chave-front-3000" \
  -F 'payload={
    "ambiente": "producao",
    "uf": "MG",
    "cnpj": "24093799000176"
  };type=application/json' \
  -F "certificado=@certs/certificado-novo.pfx" \
